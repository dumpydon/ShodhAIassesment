        "order": 30,
        "text": "IF waiting >= 21 minutes THEN escalation"
      },
      {
        "id": "ref_23cbea919f15",
        "location": "policy#ref_23cbea919f15",
        "order": 20,
        "text": "IF urgent == true THEN priority"
      },
      {
        "id": "ref_a615cdf208ff",
        "location": "policy#ref_a615cdf208ff",
        "order": 15,
        "text": "IF vip == true AND (category == \"renewals\" OR category == \"telemetry\") THEN specialist"
      },
      {
        "id": "ref_78fc72853ba9",
        "location": "policy#ref_78fc72853ba9",
        "order": 40,
        "text": "OTHERWISE THEN normal"
      },
      {
        "id": "ref_5e0396e98e3a",
        "location": "policy#ref_5e0396e98e3a",
        "order": 10,
        "text": "IF category IS MISSING THEN manual"
      }
    ],
    "version": "policy-v1"
  },
