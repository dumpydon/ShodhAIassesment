  "snippets": {
    "items": [
      {
        "id": "ref_48508637dd07",
        "source": "def decide(ticket):\n    return ticket.get(\"waiting\") is not None and ticket.get(\"waiting\") >= 1260\n"
      },
      {
        "id": "ref_399050cd5934",
        "source": "def decide(ticket):\n    return ticket.get(\"category\") is None\n"
      },
      {
        "id": "ref_c01890e95b22",
        "source": "def decide(ticket):\n    return ticket.get(\"urgent\") == True\n"
      },
      {
        "id": "ref_7936ab2ae79f",
        "source": "def decide(ticket):\n    if ticket[\"category\"] == \"renewals\":\n        return ticket.get(\"vip\") == True\n    return ticket[\"category\"] == \"telemetry\" and ticket.get(\"vip\") == True\n"
      }
    ],
    "version": "py-v1"
  },
